# Base URL the frontend calls for the backend API (no trailing slash).
# Local dev default (used automatically if this var is unset): http://127.0.0.1:8000

# If deploying as a single Vercel multi-service project (see root vercel.json --
# frontend + backend as one project, "/api/*" routed to the backend service),
# set this to a relative "/api" so requests stay same-origin:
VITE_API_BASE=/api

# If deploying the backend separately (e.g. Render/Railway) instead, set this
# to that backend's full URL:
# VITE_API_BASE=https://your-backend.onrender.com
