# Base URL the frontend calls for the backend API (no trailing slash).
# Local dev default (used automatically if this var is unset): http://127.0.0.1:8000
# On the deployed Vercel multi-service project, the frontend auto-detects
# it's not on localhost and defaults to same-origin "/api" -- this var is
# only needed to override that (e.g. pointing local dev at a remote backend).
VITE_API_BASE=/api

# Optional: enables vendor login and Bazaar Chat (Supabase). Without these,
# the rest of the app works exactly the same -- login/chat simply don't
# render. Get both from your Supabase project's Settings -> API page, and
# run backend/supabase_schema.sql in the SQL Editor once to create the
# required tables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
